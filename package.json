{
    "name": "JanusGraph",
    "version": "0.2.12",
    "author": "hackolade",
    "engines": {
        "hackolade": "6.2.4",
        "hackoladePlugin": "1.0.0"
    },
    "contributes": {
        "target": {
            "applicationTarget": "JanusGraph",
            "title": "JanusGraph",
            "versions": [
                "0.5.x",
                "0.6.x",
                "1.x"
            ]
        },
        "features": {
            "jaySchemaHasRequiredPatternField": false,
            "nestedCollections": {
                "isVirtual": true,
                "hasMultipleParents": true
            },
            "graphDB": true,
            "relationships": {
                "connectOnEntityLevel": true,
                "hasData": true
            },
            "enableForwardEngineering": {
                "jsonDocument": true,
                "jsonSchema": true,
                "excel": true,
                "plugin": true
            },
            "enableReverseEngineering": {
                "jsonDocument": true,
                "jsonSchema": true,
                "ddl": true,
                "xsd": true,
                "excel": true,
                "plugin": true
            }
        }
    },
    "description": "Hackolade plugin for JanusGraph",
    "disabled": false,
    "dependencies": {
        "@webpod/ip": "0.6.1",
        "async": "3.2.5",
        "gremlin": "3.7.3",
        "lodash": "4.18.1"
    },
    "simple-git-hooks": {
        "pre-commit": "npm run package && npx lint-staged --config lint-staged.config.js",
        "pre-push": "npm run lint"
    },
    "scripts": {
        "install": "npx patch-package",
        "lint": "oxlint . || true",
        "package": "node esbuild.package.js",
        "postinstall": "npx simple-git-hooks",
        "lint:check": "oxlint --type-aware --type-check . || true",
        "format": "prettier --write ."
    },
    "devDependencies": {
        "@hackolade/hck-esbuild-plugins-pack": "0.0.1",
        "@ianvs/prettier-plugin-sort-imports": "4.7.1",
        "esbuild": "0.27.3",
        "esbuild-node-externals": "1.20.1",
        "esbuild-plugin-clean": "1.0.1",
        "esbuild-plugin-copy": "2.1.1",
        "lint-staged": "16.2.7",
        "oxlint": "1.38.0",
        "oxlint-tsgolint": "0.10.1",
        "prettier": "3.8.1",
        "simple-git-hooks": "2.13.1"
    },
    "overrides": {
        "minimatch": "10.2.4",
        "uuid": "14.0.0"
    }
}